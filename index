<script>
// ==============================
// Matrix Rain de fondo
// ==============================
const matrixCanvas = document.getElementById('matrixCanvas');
const mCtx = matrixCanvas.getContext('2d');
let matrixCols, matrixDrops;

function initMatrix() {
  matrixCanvas.width = window.innerWidth;
  matrixCanvas.height = window.innerHeight;
  const fontSize = 14;
  matrixCols = Math.floor(matrixCanvas.width / fontSize);
  matrixDrops = Array(matrixCols).fill(1).map(() => Math.random() * matrixCanvas.height / fontSize | 0);
}

function drawMatrix() {
  mCtx.fillStyle = 'rgba(10,10,15,0.06)';
  mCtx.fillRect(0, 0, matrixCanvas.width, matrixCanvas.height);
  mCtx.fillStyle = '#00ff41';
  mCtx.font = '14px Share Tech Mono';
  const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
  for (let i = 0; i < matrixCols; i++) {
    const char = chars[Math.random() * chars.length | 0];
    mCtx.fillText(char, i * 14, matrixDrops[i] * 14);
    if (matrixDrops[i] * 14 > matrixCanvas.height && Math.random() > 0.975) {
      matrixDrops[i] = 0;
    }
    matrixDrops[i]++;
  }
  requestAnimationFrame(drawMatrix);
}

initMatrix();
drawMatrix();
window.addEventListener('resize', initMatrix);

// ==============================
// Mini grafo de red
// ==============================
const netCanvas = document.getElementById('networkCanvas');
const nCtx = netCanvas.getContext('2d');
let netPoints = [];

function initNetGraph() {
  netCanvas.width = netCanvas.clientWidth * 2;
  netCanvas.height = netCanvas.clientHeight * 2;
  nCtx.scale(2, 2);
  netPoints = [];
  for (let i = 0; i < 40; i++) {
    netPoints.push({
      x: Math.random() * netCanvas.clientWidth,
      y: Math.random() * netCanvas.clientHeight,
      vx: (Math.random() - 0.5) * 0.6,
      vy: (Math.random() - 0.5) * 0.6
    });
  }
}

function drawNetGraph() {
  const w = netCanvas.clientWidth;
  const h = netCanvas.clientHeight;
  nCtx.clearRect(0, 0, w, h);

  for (const p of netPoints) {
    p.x += p.vx; p.y += p.vy;
    if (p.x < 0 || p.x > w) p.vx *= -1;
    if (p.y < 0 || p.y > h) p.vy *= -1;
  }

  for (let i = 0; i < netPoints.length; i++) {
    for (let j = i + 1; j < netPoints.length; j++) {
      const dx = netPoints[i].x - netPoints[j].x;
      const dy = netPoints[i].y - netPoints[j].y;
      const d = Math.sqrt(dx * dx + dy * dy);
      if (d < 50) {
        nCtx.strokeStyle = `rgba(0,229,255,${0.2 * (1 - d / 50)})`;
        nCtx.lineWidth = 0.5;
        nCtx.beginPath();
        nCtx.moveTo(netPoints[i].x, netPoints[i].y);
        nCtx.lineTo(netPoints[j].x, netPoints[j].y);
        nCtx.stroke();
      }
    }
  }

  for (const p of netPoints) {
    nCtx.fillStyle = 'rgba(0,229,255,0.6)';
    nCtx.beginPath();
    nCtx.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
    nCtx.fill();
  }

  requestAnimationFrame(drawNetGraph);
}

initNetGraph();
drawNetGraph();

// ==============================
