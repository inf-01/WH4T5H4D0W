function updateUptime() {
  const elapsed = (Date.now() - startTime) / 1000 | 0;
  const m = (elapsed / 60 | 0).toString().padStart(2, '0');
  const s = (elapsed % 60).toString().padStart(2, '0');
  document.getElementById('uptime').textContent = `${m}:${s}`;
}
setInterval(updateUptime, 1000);

// Agregar mensaje al sidebar derecho
function addMsgPreview(msg, cipher) {
  const container = document.getElementById('msgPreviewContainer');
  const div = document.createElement('div');
  div.className = 'msg-preview';
  div.innerHTML = `
    <div class="time"><i class="fa-regular fa-clock"></i> ${msg.time}</div>
    <div class="from"><i class="fa-solid fa-arrow-right" style="font-size:8px;margin-right:4px"></i>${msg.from}</div>
    <div class="cipher"><i class="fa-solid fa-lock" style="font-size:8px;margin-right:3px;color:var(--danger)"></i>${cipher}</div>
    <div class="plain">${msg.text}</div>
  `;
  container.prepend(div);
  // Limitar a 6 previews
  while (container.children.length > 6) {
    container.removeChild(container.lastChild);
  }
}

