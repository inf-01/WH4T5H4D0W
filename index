// Genera texto cifrado simulado
function genCipher(len) {
  const chars = '0123456789abcdef';
  let s = '';
  for (let i = 0; i < len; i++) {
    s += chars[Math.random() * chars.length | 0];
    if ((i + 1) % 4 === 0 && i < len - 1) s += ' ';
  }
  return s;
}

function genKey() {
  return genCipher(32).replace(/\s/g, '');
}

function genIV() {
  return genCipher(16).replace(/\s/g, '');
}

function genHexDump() {
  let lines = [];
  for (let i = 0; i < 8; i++) {
    const offset = (i * 16).toString(16).padStart(8, '0');
    let hex = '';
    let ascii = '';
    for (let j = 0; j < 16; j++) {
      const byte = Math.random() * 256 | 0;
      hex += byte.toString(16).padStart(2, '0') + ' ';
      ascii += (byte >= 32 && byte <= 126) ? String.fromCharCode(byte) : '.';
    }
    lines.push(`<span class="hex-offset">${offset}</span>  <span class="hex-data">${hex}</span> <span class="hex-ascii">${ascii}</span>`);
  }
  return lines.join('\n');
}

// Anade una linea a la terminal
function addLine(text, cls = '') {
  const div = document.createElement('div');
  div.className = `line ${cls}`;
  div.innerHTML = text;
  terminal.appendChild(div);
  terminal.scrollTop = terminal.scrollHeight;
  lineCount++;
}

// Delay con promesas
function delay(ms) {
  return new Promise(r => setTimeout(r, ms));
}

// Escribe caracteres uno por uno
async function typeLine(text, cls = '', charDelay = 12) {
  const div = document.createElement('div');
  div.className = `line ${cls}`;
  terminal.appendChild(div);
  for (let i = 0; i < text.length; i++) {
    div.innerHTML = text.slice(0, i + 1) + '<span class="cursor-blink"></span>';
    terminal.scrollTop = terminal.scrollHeight;
    await delay(charDelay);
  }
  div.innerHTML = text;
}

